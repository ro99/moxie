# Rust build output
/target/

# Reference documents (documents 01-09, the architectural diagnosis) are kept
# local and are not pushed to a remote. Living records are tracked instead --
# see docs/README.md for the placement contract.
/docs/spec/*
!/docs/spec/templates/

